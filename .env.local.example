NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# FMRXR OS (mode hybride) — chemins locaux lus par /os/app et /api/os/import|export (dev uniquement)
OS_HTML_PATH=E:/FMRXR/CLAUDE PRO/FMRXR_OS/FMRXR_OS.html
OS_KG_PATH=E:/FMRXR/CLAUDE PRO/FMRXR_OS/data/knowledge-graph.json

# API agent (token Bearer) — pour les agents (Claude Code / cron) qui lisent et proposent sans cookie admin.
# Génère un secret long et aléatoire. OS_OWNER_ID facultatif (uuid du compte admin propriétaire de os_graph ;
# inutile s'il n'y a qu'une ligne os_graph).
OS_AGENT_TOKEN=change-me-long-random-secret
OS_OWNER_ID=

# Studio & Assets — racine des fichiers locaux servis en aperçu par /api/os/asset-file (dev uniquement)
OS_ASSETS_ROOT=E:/FMRXR/CLAUDE PRO

# Content Factory — chemin du launch.bat lancé par /api/os/content-factory/launch (dev uniquement)
CF_LAUNCH_BAT_PATH=E:/FMRXR/CLAUDE PRO/CONTENT_FACTORY/launch.bat

# Brain — clé API Claude pour /api/os/brain/ask (Q&A sur le graphe, admin uniquement)
ANTHROPIC_API_KEY=
